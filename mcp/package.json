  "description": "Optional local MCP server for Bootstrap OS — one connector, many isolated company instances. Markdown remains source of truth.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "bootstrap-os-mcp": "./dist/index.js"
  },
  "scripts": {
